{{> layout/header}}

<div class="container p-5">
    <div class="card">
        <div class="card-header"><b>글 수정</b></div>
        <div class="card-body">
            <form action="/board/{{board.id}}/update" method="post">

                <div class="mb-3">
                    <input type="text" class="form-control" name="title" value="{{board.title}}">
                </div>
                <div class="mb-3">
                    <textarea class="form-control" rows="5" name="content">{{board.content}}</textarea>
                </div>

                {{! 체크하면 premium=true, 체크하지 않으면 아무 값도 보재지 않음. 추후 유료, 무료 여부 처리}}
                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="premium"
                           name="premium" value="true" {{#board.premium}} checked {{/board.premium}}>
                    <label for="premium" class="form-check-label">유료 게시글로 등록(다른 사용자는 500포인트로 구매 후 열람 됨)</label>
                </div>
                <button class="btn btn-primary form-control">수정 완료</button>
            </form>
        </div>
    </div>
</div>

{{> layout/footer}}