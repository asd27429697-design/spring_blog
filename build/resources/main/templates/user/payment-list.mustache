{{> layout/header}}

<div class="container p-5">
    <div class="card">
        <div class="card-header">
            <h4 class="mb-0"><b>결제 내역</b></h4>
        </div>

        <div class="card-body">
            <!-- 반복 시작 :  -->
            {{#paymentList}}
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <h5 class="card-title mb-2">결제 {{id}}</h5>
                                <p class="text-muted mb-2"><i class="fa-solid fa-receipt"></i> 결제번호 :
                                    {{paymentId}}</p>
                                {{#pgTxId}}
                                    <p class="text-muted mb-2"><i class="fa-solid fa-hashtag"></i> PG 거래번호 : {{pgTxId}}
                                    </p>
                                {{/pgTxId}}
                                <p class="text-muted mb-2"><i class="fa-solid fa-calendar"></i> 결제일 : {{paidAt}}
                                </p>
                                <!--    결제 완료/ 환불 완료  -->
                                {{^cancelled}}
                                    <p class="text-muted mb-0">
                                        <i class="fa-solid fa-circle-info"></i> 상태 :
                                        <span class="badge bg-success">{{statusDisplay}}</span>
                                    </p>
                                {{/cancelled}}
                                {{#cancelled}}
                                    <p class="text-muted mb-0">
                                        <i class="fa-solid fa-circle-info"></i> 상태 :
                                        <span class="badge bg-secondary">{{statusDisplay}}</span>
                                    </p>
                                {{/cancelled}}
                            </div>

                            <div class="text-end">
                                {{^cancelled}}
                                    <span class="badge bg-primary fs-6 d-block mb-2">+{{amount}} P</span>
                                {{/cancelled}}
                                {{#cancelled}}
                                    <span class="badge bg-secondary text-decoration-line-through fs-6 d-block mb-2">+{{amount}}
                                        P</span>
                                {{/cancelled}}
                                <!--   환불 여부 버튼 추가 -->
                                {{#refundable}}
                                    <!-- 환불 요청 폼 태그 이동 : 결제 PK 로 처리  -->
                                    <a href="/refund/request/{{id}}" class="btn btn-outline-danger btn-sm">환불 요청</a>
                                {{/refundable}}
                            </div>


                        </div>
                    </div>
                </div>
            {{/paymentList}}

            {{^paymentList}}
                <div class="text-center py-5">
                    <i class="fa-solid fa-credit-card fa-3x"></i>
                    <h5 class="text-muted">결제 내역이 없습니다</h5>
                    <p class="text-muted">포인트를 충전해보세요</p>
                    <a href="/user/point/charge" class="btn btn-primary">포인트 충전하기</a>
                </div>
            {{/paymentList}}

            <div class="mt-4">
                <!--   추가             -->
                <a href="/refund/list" class="btn btn-info">
                    <i class="fa-solid fa-rotate-left"></i>환불 요청 내역
                </a>
                <a href="/user/detail" class="btn btn-secondary">마이페이지로 돌아가기</a>
            </div>
        </div>
    </div>
</div>

{{> layout/footer}}