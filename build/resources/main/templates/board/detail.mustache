{{> layout/header}}

<div class="container p-5">


    {{#isOwner}}
        <div class="d-flex justify-content-end">
            <a href="/board/{{board.id}}/update" class="btn btn-warning me-1">수정</a>
            <form action="/board/{{board.id}}/delete" method="post">
                <button class="btn btn-danger">삭제</button>
            </form>
        </div>
    {{/isOwner}}

    <div class="d-flex justify-content-end">
        <b>작성자</b> : {{board.username}}
    </div>

    <div>
        <h2>
            <b>{{board.title}}</b>
            {{#board.premium}} <span class="badge bg warning text-dark">유료</span> {{/board.premium}}
        </h2>
        {{#board.canRead}}
            <hr>
            <div class="m-4 p-2">
                {{board.content}}
            </div>
        {{/board.canRead}}

        {{! 유료 게시글을 못 보는 상태 }}
        {{^board.canRead}}
            <div>
                <p>유료 게시글입니다. 구매 후 전체 내용을 볼 수 있습니다 (500 P)</p>
                {{#sessionUserDto}}
                {{! 로그인 된 상태에서 포인트 차감을 통해 해당 게시글을 구매 처리 해야 한다. (db 저장 해야 함) }}
                    <form action="/board/{{board.in}}/purchase" method="post"
                          onsubmit="return confirm('500 포인트로 이 게시글을 구매 하시겠습니까?')">
                        <button type="submit" class="btn btn-primary">구매하기 500 P</button>
                    </form>
                {{/sessionUserDto}}
                {{^sessionUserDto}}
                {{! 로그인 안 된 사람은 로그인 페이지로 이동 }}
                    <a href="/login" class="btn btn-outline-primary">로그인 후 구매</a>
                {{/sessionUserDto}}
            </div>
        {{/board.canRead}}
    </div>

    {{! 댓글: 아직 기능이 없어 화면만 만들어 둡니다 }}
    <div class="card mt-3">
        <div class="card-body">
            <form action="/reply/save" method="post">
                <input type="hidden" name="boardId" value="{{board.id}}">
                <textarea class="form-control" rows="2" name="comment" placeholder="댓글을 입력하세요"></textarea>
                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-outline-primary mt-1">댓글 등록</button>
                </div>
            </form>
        </div>
        <div class="card-footer"><b>댓글 목록</b></div>
        <div class="list-group">
            <!-- 댓글 1 시작 -->
            {{#replyList}}
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div class="d-flex">
                        <div class="px-1 me-1 bg-primary text-white rounded">{{username}}</div>
                        <div>{{comment}}</div>
                    </div>
                    {{#isOwner}}
                        <form action="/reply/{{id}}/delete" method="post">
                            <input type="hidden" name="boardId" value="{{board.id}}">
                            <button class="btn"><i class="fa-solid fa-trash"></i></button>
                        </form>
                    {{/isOwner}}
                </div>
            {{/replyList}}
            <!-- 댓글 1 종료 -->


        </div>
    </div>
</div>

{{> layout/footer}}